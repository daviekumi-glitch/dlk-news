# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
# Build output — regenerated by Gradle.
/android/build
/android/app/build
/android/.gradle
/android/capacitor-cordova-android-plugins/build
/android/local.properties
/android/.idea
/android/app/release
/android/app/debug

# Capacitor copies the web app here on `cap copy`; it is a build artifact, not
# source. The rest of android/app/src is committed.
/android/app/src/main/assets/public
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json

# Native build intermediates for the bundled Cordova compatibility layer.
/android/capacitor-cordova-android-plugins/src/main/libs

# ---------------------------------------------------------------------------
# Signing material — NEVER commit these
# ---------------------------------------------------------------------------
*.keystore
*.jks
!android/app/debug.keystore
keystore.password
keystore.base64
android-secrets/
*.keystore.base64
