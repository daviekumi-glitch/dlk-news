# Agent Mobile talks only to the Base44 backend. Every value below is OPTIONAL:
# the public defaults are committed in src/lib/base44/client.ts.
#
# Point the app at a different Base44 deployment:
# NEXT_PUBLIC_BASE44_APP_ID=your-app-id
# NEXT_PUBLIC_BASE44_APP_URL=https://your-app.base44.app
#
# AI provider keys are NEVER set here. NVIDIA_API_KEY and OPENROUTER_API_KEY are
# backend secrets configured on the Base44 app and are not exposed to the client.
